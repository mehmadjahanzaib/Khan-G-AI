{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Conversation": {
      "title": "Chat Conversation",
      "description": "User conversational session with Khan G Tools assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMessage": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "Individual prompt or assistant response within a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "bot"] },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "toolCall": { "type": "object" },
        "files": { "type": "array" },
        "isClarification": { "type": "boolean" }
      },
      "required": ["id", "conversationId", "sender", "text", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document owned by userId"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "User's saved chat sessions"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual messages in a user's conversation"
    }
  }
}
