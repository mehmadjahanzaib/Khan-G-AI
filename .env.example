# ==============================================================================
# SECTION A: PUBLIC FIREBASE CLIENT CONFIGURATION
# (Safe to expose to client - used for Authentication & Firestore chat history)
# Pre-configured via AI Studio Firebase setup. Can also be overridden here if needed.
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# ==============================================================================
# SECTION B: SERVER-ONLY AI API KEYS
# (Kept secure on backend - NEVER exposed to browser)
# ==============================================================================
# GEMINI_API_KEY: Required for Google AI Studio / Gemini API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Free tier key can also be obtained at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Extremely fast inference (Llama-3, DeepSeek, Qwen).
# Free API key at: https://console.groq.com/keys
GROQ_API_KEY=""

# OPENROUTER_API_KEY: One key for multiple free models (e.g. meta-llama/llama-3-8b-instruct:free).
# Free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# MISTRAL_API_KEY: Free tier instruction following (Mistral-small / 7b).
# Free API key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=""

# DEEPSEEK_API_KEY: DeepSeek reasoning and coding API.
# API key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# ==============================================================================
# SECTION C: AI PROVIDER SELECTION
# Switch between free providers: 'gemini' | 'groq' | 'openrouter' | 'mistral' | 'deepseek'
# Defaults to 'gemini' if not set
# ==============================================================================
AI_PROVIDER="gemini"

# ==============================================================================
# SECTION D: FILE STORAGE & PROCESSING SECURITY
# ==============================================================================
MAX_FILE_SIZE_MB="100"
RATE_LIMIT_PER_HOUR="30"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

